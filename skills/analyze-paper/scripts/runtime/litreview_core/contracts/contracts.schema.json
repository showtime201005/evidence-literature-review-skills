{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litreview:contracts:1",
  "$defs": {
    "Span": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "content_hash",
        "start_byte",
        "end_byte",
        "excerpt"
      ]
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "utf-8"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object"
        },
        "metadata_provenance": {
          "type": "object"
        },
        "source_gaps": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_of": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "paper_id",
        "content_hash",
        "encoding",
        "source_path",
        "snapshot_path",
        "size_bytes",
        "metadata",
        "metadata_provenance",
        "source_gaps"
      ]
    },
    "SourceBlock": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "heading",
            "body",
            "table",
            "equation",
            "code",
            "caption",
            "references",
            "metadata",
            "format"
          ]
        },
        "section_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "block_id",
        "document_id",
        "content_hash",
        "hash",
        "kind",
        "section_path",
        "start_byte",
        "end_byte",
        "start_line",
        "end_line"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          },
          "minItems": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "author_result",
            "author_limitation",
            "secondary_report",
            "context",
            "analyst_inference"
          ]
        }
      },
      "required": [
        "evidence_id",
        "spans",
        "excerpt",
        "source_role"
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "source_fact",
            "synthesis",
            "analyst_inference",
            "scope_statement"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "support_status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "contradicted",
            "uncertain",
            "unverified"
          ]
        }
      },
      "required": [
        "claim_id",
        "text",
        "claim_type",
        "evidence_refs",
        "support_status"
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "reported",
            "not_reported",
            "not_applicable",
            "source_missing",
            "not_checked",
            "parse_error"
          ]
        },
        "text": {
          "type": "string"
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "text",
        "claim_refs"
      ]
    },
    "CoverageRecord": {
      "type": "object",
      "properties": {
        "coverage_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "layer": {
          "enum": [
            "delivery",
            "analysis",
            "verification"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "delivered",
            "analyzed",
            "reused_exact_content",
            "reference_catalogued",
            "failed",
            "missing"
          ]
        }
      },
      "required": [
        "coverage_id",
        "block_id",
        "task_id",
        "artifact_refs",
        "layer",
        "status"
      ]
    },
    "PaperAnalysis": {
      "type": "object",
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "analysis_profile": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          }
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "coverage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "paper_id",
        "analysis_profile",
        "fields",
        "claim_refs",
        "coverage_refs"
      ]
    },
    "ComparisonCell": {
      "type": "object",
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "mixed",
            "not_addressed",
            "unresolved"
          ]
        },
        "material_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "conditions": {
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "dimension",
        "status",
        "material_refs",
        "verification_status",
        "conditions"
      ]
    },
    "ComparisonSet": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "material_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComparisonCell"
          },
          "minItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "contradiction_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        }
      },
      "required": [
        "question",
        "dimensions",
        "material_refs",
        "cells",
        "unknowns",
        "contradiction_candidates"
      ]
    },
    "ClaimMapping": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "claim_id",
        "start_char",
        "end_char"
      ]
    },
    "ReviewDraft": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 0
        },
        "claim_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimMapping"
          },
          "minItems": 0
        },
        "citation_map": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "reference_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "scan_status": {
          "enum": [
            "not_checked",
            "reviewed"
          ]
        }
      },
      "required": [
        "text",
        "claims",
        "claim_mappings",
        "citation_map",
        "scan_status"
      ]
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "contradicted",
            "uncertain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "claim_id",
        "status",
        "reason",
        "evidence_refs"
      ]
    },
    "VerificationSet": {
      "type": "object",
      "properties": {
        "target_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "target_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator_checks": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "verdicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Verdict"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "scan_completed": {
          "type": "boolean"
        },
        "scan_findings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target_artifact_id",
        "target_hash",
        "locator_checks",
        "verdicts",
        "issues",
        "scan_completed",
        "scan_findings",
        "verification_method"
      ]
    },
    "TaskSpec": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "enum": [
            "analyze-paper",
            "compare-papers",
            "write-review",
            "verify-citations",
            "literature-review"
          ]
        },
        "input_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object"
        },
        "output_location": {
          "type": "string",
          "minLength": 1
        },
        "context_budget": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "parent_job": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "capability",
        "input_artifact_refs",
        "request",
        "profile",
        "output_location"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "needs_input",
            "failed",
            "cancelled"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "usage": {
          "type": "object"
        }
      },
      "required": [
        "task_id",
        "status",
        "artifact_refs",
        "source_hashes",
        "issues"
      ]
    },
    "CorpusIndex": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "minItems": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceBlock"
          },
          "minItems": 0
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "logical_paper_count": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "const": "corpus_only"
        },
        "external_lookup": {
          "const": false
        }
      },
      "required": [
        "documents",
        "blocks",
        "dispositions",
        "logical_paper_count",
        "policy",
        "external_lookup"
      ]
    },
    "CoverageSet": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageRecord"
          },
          "minItems": 0
        },
        "execution": {
          "enum": [
            "partial",
            "complete",
            "blocked"
          ]
        },
        "quality": {
          "enum": [
            "unverified",
            "needs_revision",
            "passed"
          ]
        }
      },
      "required": [
        "records",
        "execution",
        "quality"
      ]
    },
    "ExternalMaterials": {
      "type": "object",
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "verification_status": {
          "const": "unverified"
        },
        "input_kind": {
          "enum": [
            "notes",
            "csv",
            "bibliography"
          ]
        }
      },
      "required": [
        "materials",
        "verification_status",
        "input_kind"
      ]
    },
    "RunConfig": {
      "type": "object",
      "properties": {
        "source_policy": {
          "const": "corpus_only"
        },
        "external_lookup": {
          "const": false
        },
        "max_papers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "depth": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "research_question": {
          "type": "string",
          "minLength": 1
        },
        "completion_priority": {
          "const": "full_corpus"
        },
        "deadline_mode": {
          "enum": [
            "soft",
            "hard"
          ]
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "target_minutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "source_policy",
        "external_lookup",
        "max_papers",
        "depth",
        "research_question",
        "completion_priority",
        "deadline_mode",
        "max_workers",
        "max_repair_rounds"
      ]
    },
    "ManifestEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "path",
        "paper_id"
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestEntry"
          },
          "minItems": 1
        }
      },
      "required": [
        "documents"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "field": {
          "enum": [
            "research_question",
            "contributions",
            "method",
            "evaluation",
            "results",
            "limitations",
            "conditions",
            "relevance",
            "unexpected_findings"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "author_result",
            "author_limitation",
            "secondary_report",
            "context",
            "analyst_inference"
          ]
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          },
          "minItems": 1
        }
      },
      "required": [
        "field",
        "text",
        "quote",
        "source_role"
      ]
    },
    "PartObservation": {
      "type": "object",
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "analyzed",
            "reference_catalogued"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 0
        }
      },
      "required": [
        "part_id",
        "status",
        "summary",
        "findings"
      ]
    },
    "ChunkAnalysis": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartObservation"
          },
          "minItems": 1
        }
      },
      "required": [
        "task_id",
        "source_hashes",
        "observations"
      ]
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "artifact_type": {
          "const": "SourceDocument"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/SourceDocument"
        },
        "producer": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "artifact_type",
        "artifact_id",
        "payload"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "artifact_type": {
          "const": "SourceBlock"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/SourceBlock"
        },
        "producer": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "artifact_type",
        "artifact_id",
        "payload"
      ]
    },
